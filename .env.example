# Copie para ".env" e preencha. O arquivo .env NUNCA deve ser publicado.

# Chave da API Estêvão (calendário, leituras e coletas)
ESTEVAO_API_KEY=estevao_cole_sua_chave_aqui
ESTEVAO_PRAYER_BOOK=loc_2015
# Versão bíblica opcional (ex.: nvi, ara, acf)
ESTEVAO_BIBLE_VERSION=

# Senha do painel administrativo (/admin). Use uma senha forte.
ADMIN_SENHA=

# Porta do servidor
PORT=3000

# Descomente se o site ficar atrás de um proxy/HTTPS (Nginx, Render, Railway…)
# ATRAS_DE_PROXY=1

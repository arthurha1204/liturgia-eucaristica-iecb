{
  "name": "liturgia-eucaristica-iecb",
  "version": "1.0.0",
  "description": "Site da Igreja Episcopal Carismática do Brasil (IECB), com painel administrativo e gerador do folheto da Santa Eucaristia (API Estêvão).",
  "type": "module",
  "private": true,
  "scripts": {
